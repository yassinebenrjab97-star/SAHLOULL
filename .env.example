# Supabase — required only for the hosted (production) mode.
# When these are empty the app runs in a self-contained local/demo mode
# (data persisted in the browser) so it can be evaluated without a backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the AI assistant endpoint. When empty the app calls the
# Supabase edge function "ai-assistant" (production) or the built-in local
# assistant fallback (demo mode).
VITE_AI_ENDPOINT=
